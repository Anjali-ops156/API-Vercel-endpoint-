# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.

# ── Supabase — Settings > API ────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# ── Feature 01: WhatsApp notification (CallMeBot) ────────────────────────
# Your own WhatsApp number with country code, no spaces, no +
# India example: 919876543210
WHATSAPP_PHONE=919876543210
# The key CallMeBot sends you on WhatsApp after you message the bot
WHATSAPP_APIKEY=123456

# ── Feature 02: Email notification (EmailJS) ─────────────────────────────
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your-public-key
# Optional but recommended for server-side sending
EMAILJS_PRIVATE_KEY=your-private-key

# ── Feature 03: Weather suggestion (Open-Meteo) ──────────────────────────
# Nothing to add — Open-Meteo needs no key and no sign-up.
